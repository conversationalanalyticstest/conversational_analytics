# Credenciales de Snowflake — copia este fichero a .env y rellena los valores.
# NUNCA commitees .env (esta en .gitignore).
#
# La autenticacion va por PAT (Programmatic Access Token), no por contrasena.
# Crear el token en Snowsight (Settings > Authentication > Programmatic access tokens)
# o por SQL:
#   ALTER USER <tu_usuario> ADD PROGRAMMATIC ACCESS TOKEN cicd_demo_token
#     ROLE_RESTRICTION = 'CICD_DEMO_ROLE'
#     DAYS_TO_EXPIRY = 90;
# El valor solo se muestra una vez: copialo aqui en ese momento.

# Identificador de cuenta, formato <organizacion>-<nombre_cuenta>. Se obtiene con:
#   SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=

# Usuario propietario del PAT.
SNOWFLAKE_USER=

# El PAT completo. Es un secreto: tratalo como una contrasena.
SNOWFLAKE_PAT=

# Contexto de sesion. Estos cuatro valores son fijos para la demo.
SNOWFLAKE_ROLE=CICD_DEMO_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=CICD_DEMO
SNOWFLAKE_SCHEMA=DATA

# ---------------------------------------------------------------------------
# Agente conversacional (feature 003). Proveedor del orquestador configurable
# por LLM_PROVIDER, ver specs/003-conversational-agent/research.md, D-11.
# Cortex Analyst (traduccion NL->SQL) se autentica siempre con SNOWFLAKE_PAT
# de arriba, sea cual sea LLM_PROVIDER.
# ---------------------------------------------------------------------------

# openai (defecto) | cortex. Hoy "openai" porque esta cuenta Snowflake es
# trial y no tiene inferencia Cortex habilitada (D-11).
LLM_PROVIDER=openai

# Obligatoria SOLO si LLM_PROVIDER=openai (el caso por defecto). Se lee
# unicamente en ese caso: con LLM_PROVIDER=cortex no debe existir esta
# variable (lo verifica test_provider_matches_config, D-08).
OPENAI_API_KEY=

# Opcional. Defecto en codigo: gpt-4.1-mini. Solo se usa con LLM_PROVIDER=openai via API
# publica; si AZURE_OPENAI_ENDPOINT esta definido, se ignora (se usa AZURE_OPENAI_DEPLOYMENT).
OPENAI_MODEL=

# Backend Azure OpenAI Service, alternativa a la API publica dentro de LLM_PROVIDER=openai
# (mismo SDK `openai`, cliente AzureOpenAI). Si AZURE_OPENAI_ENDPOINT esta vacio se usa la
# API publica con OPENAI_API_KEY + OPENAI_MODEL de arriba. Si esta relleno, hacen falta las
# tres: OPENAI_API_KEY pasa a ser la clave de suscripcion del recurso Azure.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Opcional. Solo se usa con LLM_PROVIDER=cortex; se fija tras verificar
# disponibilidad y soporte de function calling (D-05).
CORTEX_MODEL=

# Opcional. Semantic view que consulta Cortex Analyst.
SNOWFLAKE_SEMANTIC_VIEW=CICD_DEMO.DATA.SV_PHARMA_SALES
